# Copy to .env next to docker-compose.yml and fill in the secrets.
#   openssl rand -hex 32        -> SERVICE_KEK
#   openssl rand -base64 48     -> SERVICE_TOKEN, AUTH_SECRET, POSTGRES_PASSWORD

POSTGRES_PASSWORD=
SERVICE_TOKEN=
SERVICE_KEK=
AUTH_SECRET=

# The public URL the console is reached at; magic links point here.
AUTH_URL=http://localhost:3000
WEB_PORT=3000

# SMTP for sign-in links, e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=
# No SMTP yet? Set MAGIC_LINK_LOG=1 and sign-in links are printed to
# `docker compose logs web`. Anyone who can read that log can sign in as anyone,
# so use it to create the first account, then configure EMAIL_SERVER.
MAGIC_LINK_LOG=
EMAIL_FROM=Canton Assurance <no-reply@example.com>

# Transaction simulator (docker compose --profile simulator up). Read-only:
# the token needs read rights on the parties you simulate as, nothing more.
# JSON Ledger API of the participant to simulate against (validator's participant)
CANTON_SIM_LEDGER_URL=https://validator.example/api/json-api
# Bearer token value, or a path to a file containing it (mounted into the container)
CANTON_SIM_TOKEN=
CANTON_SIM_TOKEN_FILE=
# Ledger API user id when the token does not carry one
CANTON_SIM_USER_ID=canton-sim
# Optional: Splice Scan URL to price traffic and fees with live network values
CANTON_SIM_SCAN_URL=https://scan.sv-1.global.canton.network.sync.global
# Forward a caller's Authorization header to the participant (default true)
CANTON_SIM_FORWARD_AUTH=true
# Browser origins allowed to call the simulator API directly, comma-separated.
# Empty (default): no CORS headers; the console reaches it server-side anyway.
CANTON_SIM_CORS_ORIGINS=
CANTON_SIM_PORT=8787
