# Copy to .env for local development. docker-compose.yml supplies its own.

# Postgres. `npm run db:dev` starts an embedded one at this address.
DATABASE_URL="postgresql://canton:canton@127.0.0.1:54329/canton"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-change-me-change-me-change-me-1234"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Magic-link email. Leave EMAIL_SERVER empty in development: links are written
# to .devmail.log and shown at /dev/mail instead of being sent. In production
# (`next start`) either set EMAIL_SERVER or MAGIC_LINK_LOG=1 (links to stdout).
EMAIL_SERVER=""
EMAIL_FROM="Canton Assurance <no-reply@example.com>"

# The signing service (rust/solvency-service). Same token on both sides.
SERVICE_URL="http://127.0.0.1:8790"
SERVICE_TOKEN="dev-service-token-dev-service-token-0000"

# The transaction simulator (rust/sim-server). Optional: leave unset and the
# Simulator page explains how to enable it. No token: the simulator holds its
# own read-only participant credential.
SIMULATOR_URL="http://127.0.0.1:8787"

NEXT_PUBLIC_APP_NAME="Canton Assurance Layer"
